{
  "name": "dsh-sidebar-more",
  "version": "0.2.2",
  "description": "把左侧栏的面板入口按需折叠进「更多」菜单，为工作区与会话列表腾出空间，折叠状态跨刷新保留 / Folds left-sidebar panel entries into a More menu and keeps the folded state across reloads",
  "license": "MIT",
  "author": "梅钰轩 <meiyuxuans@foxmail.com> (https://github.com/meiyuxuan2007)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meiyuxuan2007/dsh-sidebar-more.git"
  },
  "homepage": "https://github.com/meiyuxuan2007/dsh-sidebar-more#readme",
  "bugs": {
    "url": "https://github.com/meiyuxuan2007/dsh-sidebar-more/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "navigation",
    "ui"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
